{
  "name": "wrangl-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "bun scripts/write-headers.ts && bun scripts/write-404.ts && bun scripts/write-seo-files.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "bun test --path-ignore-patterns 'tests/e2e/**'",
    "test:e2e": "playwright test",
    "test:e2e:landing": "playwright test tests/e2e/landing-page.spec.ts",
    "deploy": "wrangler pages deploy dist",
    "verify:prerender": "bun scripts/verify-prerender.ts"
  },
  "dependencies": {
    "@unhead/react": "^3.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.16.0",
    "three": "0.160.0",
    "vite-plugin-react-ssg": "^0.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250514.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "js-yaml": "^4.1.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.12",
    "wrangler": "^4.25.0"
  }
}
