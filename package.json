{
  "name": "wrangl",
  "productName": "Wrangl",
  "version": "0.2.0",
  "description": "The agent terminal for Robinhood Chain",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
