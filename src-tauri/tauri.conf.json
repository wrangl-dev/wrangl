{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wrangl",
  "version": "0.2.0",
  "identifier": "dev.wrangl.app",
  "build": {
    "beforeDevCommand": "bun run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wrangl",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
