{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wrangl",
  "version": "0.2.0",
  "identifier": "dev.wrangl.app",
  "build": {
    "beforeDevCommand": "bun run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wrangl",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.agentclientprotocol.com; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "appimage", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "publisher": "Wrangl",
    "homepage": "https://wrangl-landing.pages.dev",
    "category": "DeveloperTool",
    "shortDescription": "The agent terminal for Robinhood Chain",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwNkY4QUZCNzM3RTQ2NDcKUldSSFJuNXorNHB2a0J2bEYwKzJVRGw1SlBycnMxSUozd0wwZXgyZ1E0dHYzc1BrMFdMVjUwM0UK",
      "endpoints": ["https://github.com/wrangl-dev/wrangl/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
