{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Wrangl",
	"mainBinaryName": "wrangl",
	"version": "0.1.1",
	"identifier": "dev.wrangl.app",
	"build": {
		"beforeDevCommand": "npx vite --config vite.config.tauri.ts",
		"devUrl": "http://localhost:5180/tauri-index.html",
		"beforeBuildCommand": "npx vite build --config vite.config.web.ts && npx vite build --config vite.config.tauri.ts",
		"frontendDist": "../dist-tauri"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"label": "main",
				"url": "tauri-index.html",
				"title": "Wrangl",
				"width": 1200,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600,
				"decorations": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": {
					"x": 14,
					"y": 16
				},
				"visible": false,
				"transparent": false,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:* ws://127.0.0.1:* http://127.0.0.1:* https://api.github.com; frame-src http://127.0.0.1:*; worker-src 'self' blob:; img-src 'self' asset: http://asset.localhost data: blob: https:; font-src 'self' data:; media-src 'self' blob: https:;"
		}
	},
	"plugins": {
		"fs": {
			"requireLiteralLeadingDot": false
		},
		"updater": {
			"active": true,
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwNkY4QUZCNzM3RTQ2NDcKUldSSFJuNXorNHB2a0J2bEYwKzJVRGw1SlBycnMxSUozd0wwZXgyZ1E0dHYzc1BrMFdMVjUwM0UK",
			"endpoints": [
				"https://github.com/wrangl-dev/wrangl/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"externalBin": [
			"bin/rg"
		],
		"resources": {
			"../LICENSE": "LICENSE",
			"resources/licenses/third-party.md": "licenses/third-party.md"
		},
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"publisher": "Wrangl",
		"copyright": "Copyright © 2026 Wrangl",
		"category": "Productivity",
		"shortDescription": "Wrangl - Project-aware terminal manager",
		"longDescription": "Wrangl is a desktop application built with Tauri for enhanced productivity. Organize terminals by project with persistent sessions and snapshots.",
		"macOS": {
			"entitlements": "Entitlements.plist"
		},
		"windows": {
			"nsis": {
				"displayLanguageSelector": false
			}
		}
	}
}
